{% include 'header_shop.html' %}
<style>

    .container {
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    header {
        background-color: var(--primary-color);
        color: white;
        padding: 20px 25px;
        text-align: center;
        border-top-left-radius: var(--border-radius);
        border-top-right-radius: var(--border-radius);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    header h1 {
        margin: 0;
        font-size: 1.6em;
        font-weight: 600;
    }

    main {
        padding: 25px;
        flex-grow: 1;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--text-color);
        font-size: 0.95em;
    }

    .form-group input[type="text"],
    .form-group input[type="tel"],
    .form-group textarea {
        width: calc(100% - 20px);
        padding: 12px 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1em;
        color: var(--text-color);
        transition: var(--transition);
        box-sizing: border-box;
    }

    .form-group input[type="text"]:focus,
    .form-group input[type="tel"]:focus,
    .form-group textarea:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(186, 74, 194, 0.2);
        outline: none;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        margin-top: 25px;
        margin-bottom: 30px;
    }

    .checkbox-group input[type="checkbox"] {
        margin-left: 10px;
        transform: scale(1.2);
        accent-color: var(--primary-color);
    }

    .checkbox-group label {
        margin-bottom: 0;
        font-weight: 500;
        color: #444;
    }

    .btn {
        padding: 12px 25px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1.1em;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        transition: var(--transition);
    }

    .btn-primary {
        background-color: var(--primary-color);
        color: white;
        width: 100%;
        margin-bottom: 15px;
    }

    .btn-primary:hover {
        background-color: #a53d9e;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background-color: var(--light-color);
        color: var(--text-color);
        width: 100%;
        border: 1px solid #ccc;
    }

    .btn-secondary:hover {
        background-color: #e0e0e0;
        transform: translateY(-2px);
    }

    .flashes {
        list-style: none;
        padding: 0;
        margin: -15px 0 20px 0;
        border-radius: 8px;
        overflow: hidden;
    }

    .flashes li {
        padding: 15px 20px;
        margin-bottom: 10px;
        border-radius: 8px;
        font-size: 0.95em;
        font-weight: 500;
        display: flex;
        align-items: center;
    }

    .flashes li.success {
        background-color: var(--success-color);
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .flashes li.error,
    .flashes li.danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .flashes li.info {
        background-color: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    footer {
        margin-top: 20px;
        padding: 15px;
        text-align: center;
        color: var(--footer-text);
        font-size: 0.85em;
        background-color: var(--footer-bg);
        border-top: 1px solid #eee;
        border-bottom-left-radius: var(--border-radius);
        border-bottom-right-radius: var(--border-radius);
    }

    @media (max-width: 768px) {
        .container {
            margin: 0;
            border-radius: 0;
            box-shadow: none;
        }

        header {
            border-radius: 0;
        }

        footer {
            border-radius: 0;
        }

        main {
            padding: 15px;
        }

        header h1 {
            font-size: 1.4em;
        }

        .btn {
            padding: 10px 20px;
            font-size: 1em;
        }
    }
</style>
<div class="container">
    <header>
        <h1>تعديل العنوان</h1>
    </header>

    <main>
        <form action="{{ url_for('order.edit_address_page', address_id=address['id']) }}" method="post">
            <div class="form-group">
                <label for="recipient_name">اسم المستلم:</label>
                <input type="text" id="recipient_name" name="recipient_name"
                       value="{{ address['recipient_name'] }}"
                       placeholder="أدخل اسم المستلم كاملاً" required>
            </div>

            <div class="form-group">
                <label for="recipient_phone">رقم هاتف المستلم:</label>
                <input type="tel" id="recipient_phone" name="recipient_phone"
                       value="{{ address['recipient_phone'] }}" placeholder="مثال: 771234567"
                       required>
            </div>

            <div class="form-group">
                <label for="address_type">نوع العنوان:</label>
                <input type="text" id="address_type" name="address_type"
                       value="{{ address['address_type'] }}" placeholder="مثلاً: منزل، عمل، آخر"
                       required>
            </div>

            <div class="form-group">
                <label for="city">المدينة:</label>
                <input type="text" id="city" name="city" value="{{ address['city'] }}"
                       placeholder="مثلاً: صنعاء، عدن" required>
            </div>

            <div class="form-group">
                <label for="region">المنطقة/الحي:</label>
                <input type="text" id="region" name="region" value="{{ address['region'] }}"
                       placeholder="مثلاً: السنينة، الستين" required>
            </div>

            <div class="form-group">
                <label for="full_address_description">الوصف التفصيلي للعنوان:</label>
                <textarea id="full_address_description" name="full_address_description" rows="4"
                          placeholder="الشارع، رقم المبنى، علامات مميزة (بجوار المسجد الفلاني)"
                          required>{{ address['full_address_description'] }}</textarea>
            </div>

            <div class="form-group checkbox-group">
                <input type="checkbox" id="is_default" name="is_default" {% if address['is_default'] %} checked {% endif %}>
                <label for="is_default">تعيين كعنوان افتراضي</label>
            </div>

            <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
            <a href="{{ url_for('order.confirm_order_page') }}" class="btn btn-secondary">إلغاء</a>
        </form>
    </main>

    <footer>
        <p>&copy; 2025 متجر Rezza. كل الحقوق محفوظة.</p>
    </footer>
</div>
{% include 'footer.html' %}